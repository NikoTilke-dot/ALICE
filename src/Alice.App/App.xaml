<Application x:Class="Alice.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Alice.AppConverters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:NodeKindToGlyphConverter x:Key="NodeKindToGlyphConverter"/>
        <!-- ================= ALICE Design System – calm, premium, readable ================= -->
        <!-- Flächen -->
        <SolidColorBrush x:Key="BgMain" Color="#0B0C12"/>
        <SolidColorBrush x:Key="BgPanel" Color="#15161F"/>
        <SolidColorBrush x:Key="BgPanel2" Color="#1E2030"/>
        <SolidColorBrush x:Key="BgEditor" Color="#11121A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1B2A"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1E2030"/>
        <!-- Text -->
        <SolidColorBrush x:Key="FgMain" Color="#F1F2F8"/>
        <SolidColorBrush x:Key="FgMuted" Color="#9FA2BC"/>
        <SolidColorBrush x:Key="FgFaint" Color="#6E7194"/>
        <!-- Akzent -->
        <SolidColorBrush x:Key="Accent" Color="#7C7CF4"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#9B9BF8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#252646"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#3B3D6B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#262839"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#1F2133"/>
        <SolidColorBrush x:Key="Success" Color="#4ADE80"/>
        <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Danger" Color="#F87171"/>
        <!-- Banner (eigene Grafik, vereinfachter Mond-Himmel) -->
        <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#171433"/>
            <GradientStop Offset="0.55" Color="#2A2452"/>
            <GradientStop Offset="1" Color="#141026"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GardenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#1A1440"/>
            <GradientStop Offset="1" Color="#0B0C12"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PaperBrush" Color="#181A2B"/>
        <SolidColorBrush x:Key="BoardBg" Color="#0F1018"/>
        <DrawingBrush x:Key="BoardGridBrush" Viewport="0,0,40,40" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#22243A" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,40,40"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="EditorFont">Georgia, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

        <!-- ================= Buttons ================= -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Background" Value="{StaticResource BgPanel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        </Style>

        <!-- ================= Inputs ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgEditor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource EditorFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <!-- ComboBox: weisser Hintergrund (Windows-Standard) -> schwarze Schrift = lesbar -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1E"/>
            <Setter Property="BorderBrush" Value="#8A8FA3"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#E3E6FF"/><Setter Property="Foreground" Value="#1A1A1E"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- ================= Listen / Baum ================= -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#23263A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Tabs (Pill) ================= -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource FgMain}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Typografie & Bausteine ================= -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Menü -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>
        <!-- Alle Dropdowns: schwarze Schrift auf weissem Grund (wie gewünscht) -->
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#1A1A1E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D3E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#E3E6FF"/><Setter Property="Foreground" Value="#1A1A1E"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E3E6FF"/><Setter Property="Foreground" Value="#1A1A1E"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter Property="Background" Value="#E3E6FF"/><Setter Property="Foreground" Value="#1A1A1E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Oberste Menüleiste: dunkel, weisse Schrift (kein Dropdown) -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource FgMain}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource FgMain}"/></Trigger>
                <Trigger Property="IsFocused" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource FgMain}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
