            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding ShowNavigator, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource GardenBrush}" Height="120" Padding="10"><StackPanel VerticalAlignment="Center"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="24" Foreground="{StaticResource FgMuted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ProjectTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Your world. Your words." FontSize="11" Foreground="{StaticResource FgMuted}" HorizontalAlignment="Center" FontStyle="Italic"/></StackPanel></Border>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8"><TextBlock Text="Projekt-Explorer" FontSize="14" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><TextBox Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="Suche im Projekt"/><Button Content="Suchen" Command="{Binding Search.RunSearchCommand}" Style="{StaticResource PrimaryButton}"/></DockPanel><TextBlock Text="{Binding Search.Results, Mode=OneWay}" FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Manuskript" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/></StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8"><UniformGrid Columns="2"><Button Content="Charaktere" Command="{Binding ShowCharactersCommand}" Margin="0,0,4,4"/><Button Content="Welt" Command="{Binding ShowWorldCommand}" Margin="4,0,0,4"/><Button Content="Zeitleiste" Command="{Binding ShowTimelineCommand}" Margin="0,4,4,0"/><Button Content="Recherche" Command="{Binding ShowResearchCommand}" Margin="4,4,0,0"/><Button Content="+ Kapitel" Command="{Binding AddChapterCommand}" Margin="0,4,4,0"/><Button Content="+ Szene" Command="{Binding AddSceneCommand}" Margin="4,4,0,0"/><Button Content="Löschen" Command="{Binding DeleteNodeCommand}" Style="{StaticResource DangerButton}" Margin="0,4,4,0"/></UniformGrid></Border>
                    <TreeView x:Name="NavigatorTree" ItemsSource="{Binding NavigatorItems}" Margin="4,0,4,8"><TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Margin="0,1"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" Foreground="{StaticResource FgMuted}" Margin="0,0,6,0" FontSize="12"/><TextBlock Text="{Binding Title}" FontSize="13"/></StackPanel></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="Transparent" Visibility="{Binding ShowNavigator, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Border Grid.Column="2" Background="{StaticResource PaperBrush}"><DockPanel><Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6" Visibility="{Binding ShowEditorBar, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><ComboBox IsEditable="False" SelectedValuePath="Content" SelectedValue="{Binding Editor.EditorFont, Mode=TwoWay}" MinWidth="150" Margin="0,0,6,0"><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Cambria"/><ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Garamond"/><ComboBoxItem Content="Times New Roman"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Verdana"/><ComboBoxItem Content="Tahoma"/><ComboBoxItem Content="Palatino Linotype"/><ComboBoxItem Content="Courier New"/><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Segoe UI Variable"/></ComboBox><ComboBox IsEditable="False" SelectedValuePath="Content" SelectedValue="{Binding Editor.EditorFontSize, Mode=TwoWay}" MinWidth="64" Margin="0,0,6,0"><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="22"/><ComboBoxItem Content="24"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/><ComboBoxItem Content="48"/></ComboBox><Button Content="Rückgängig" Command="{Binding UndoCommand}"/><Button Content="Wiederholen" Command="{Binding RedoCommand}" Margin="6,0,0,0"/><Button Content="Snapshot" Command="{Binding NewSnapshotCommand}" Margin="6,0,0,0"/></StackPanel></StackPanel></Border><ContentControl Content="{Binding CurrentWorkspace}"/></DockPanel></Border>
            <Border Grid.Column="3" Background="Transparent" Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Border Grid.Column="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVisibilityConverter}}"><DockPanel><ContentControl DockPanel.Dock="Top" Height="380" Content="{Binding Inspector}"/><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding ShowAi, Converter={StaticResource BoolToVisibilityConverter}}"><ContentControl Content="{Binding Ai}"/></Border></DockPanel></Border>
        </Grid>
    </DockPanel>
</Window>





