<Window x:Class="Alice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Alice.AppConverters"
        xmlns:vm="clr-namespace:Alice.App.ViewModels"
        Title="ALICE – Advanced Literary &amp; Creative Intelligence Studio"
        Width="1600" Height="960" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}" Foreground="{StaticResource FgMain}">
    <Window.Resources>
        <!-- Editor: ruhig, lesbar, fokussiert -->
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <ScrollViewer Background="{StaticResource PaperBrush}" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" MaxWidth="760" Margin="40,18,40,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Border Width="120" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="16" Foreground="{StaticResource FgMuted}"/>
                        <Border Width="120" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Kapitel" FontFamily="{StaticResource EditorFont}" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                    <TextBox Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource EditorFont}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0,6" MinWidth="200"/>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="10,3" HorizontalAlignment="Center" Margin="0,4,0,0"><TextBlock Text="{Binding StatusLabel, Mode=OneWay}" Foreground="{StaticResource AccentStrong}" FontSize="12" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="Synopsis" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                    <TextBox Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="64" FontSize="13" Foreground="{StaticResource FgMuted}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" MaxWidth="760" Margin="40,6,40,0" HorizontalAlignment="Center">
                    <Border Style="{StaticResource EditorCard}" Padding="0" Background="Transparent" BorderThickness="0">
                        <TextBox x:Name="EditorTextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="320" BorderThickness="0" Background="Transparent" FontFamily="{Binding EditorFont, Mode=OneWay}" FontSize="{Binding EditorFontSize, Mode=OneWay}" Padding="18,8" KeyDown="InlineAi_KeyDown">
                            <TextBox.ContextMenu><ContextMenu>
                                <MenuItem Header="KI hier schreiben (Ctrl+K)" Click="InlineAi_Open_Click"/>
                                <MenuItem Header="Auswahl mit KI umschreiben" Click="InlineAi_Open_Click"/>
                                <MenuItem Header="AI-Marker einfügen" Click="InlineAi_Marker_Click"/>
                                <MenuItem Header="KI-Marker ausführen" Click="InlineAi_RunMarker_Click"/>
                            </ContextMenu></TextBox.ContextMenu>
                        </TextBox>
                    </Border>
                    <TextBlock FontSize="12" Foreground="{StaticResource FgMuted}" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Run Text="Wörter: "/><Run Text="{Binding WordCount, Mode=OneWay}"/><Run Text="  ·  Zeichen: "/><Run Text="{Binding CharCount, Mode=OneWay}"/><Run Text="  ·  Lesezeit: "/><Run Text="{Binding ReadingMinutes, Mode=OneWay}"/><Run Text=" Min"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Row="2" Margin="40,12,40,0" MaxWidth="760" HorizontalAlignment="Center" Style="{StaticResource EditorCard}" Padding="10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                            <TextBlock Text="Suchen" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding FindText}" Width="170" Margin="0,0,6,0"/>
                            <Button Content="Suchen" Command="{Binding DoFindCommand}"/>
                            <TextBlock Text="Ersetzen mit" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <TextBox Text="{Binding ReplaceText}" Width="170" Margin="0,0,6,0"/>
                            <Button Content="Ersetzen" Command="{Binding DoReplaceCommand}"/>
                            <Button Content="Snapshot erstellen" Command="{Binding CreateSnapshotCommand}" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"/>
                            <Button Content="KI hier schreiben (Ctrl+K)" Click="InlineAi_Open_Click" Margin="8,0,0,0"/>
                            <Button Content="AI-Marker einfügen" Click="InlineAi_Marker_Click" Margin="8,0,0,0"/>
                            <Button Content="KI-Marker ausführen" Click="InlineAi_RunMarker_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FindResult}" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,6,0,0"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="3" Margin="40,8,40,14" MaxWidth="760" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Snapshots" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" Margin="0,4,10,0"/>
                    <ListBox Grid.Column="1" ItemsSource="{Binding Snapshots}" MaxHeight="52" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource BgPanel2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="10,4" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="12"/><TextBlock Text=" - " Foreground="{StaticResource FgMuted}"/><TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="{StaticResource FgMuted}"/><Button Content="Wiederherstellen" Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="6,2" Margin="6,0,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Grid>
            </ScrollViewer>
        </DataTemplate>
        <!-- Outliner: Tabellen-artig, scannbar -->
        <DataTemplate DataType="{x:Type vm:OutlinerViewModel}">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Titel" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="1" Text="Status" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="2" Text="Wörter" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="3" Text="Typ" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="4" Text="Synopsis" Style="{StaticResource SectionTitle}"/></Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Padding="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/><Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentStrong}"/></Border><TextBlock Grid.Column="2" Text="{Binding WordCount, Mode=OneWay}" Foreground="{StaticResource FgMuted}"/><TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="{StaticResource FgMuted}"/><TextBlock Grid.Column="4" Text="{Binding Synopsis, Mode=OneWay}" Foreground="{StaticResource FgMuted}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid>
        </DataTemplate>
        <!-- Corkboard: Karten mit Farbe und Status -->
        <DataTemplate DataType="{x:Type vm:CorkboardViewModel}">
            <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Corkboard - Ihre Szenen auf Karten. Farbe = Status. Klicken Sie im Navigator ein Dokument an, um es zu bearbeiten." Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="260" ItemHeight="196"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="244" Margin="0,0,12,12" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource CardBrush}"><DockPanel><Border DockPanel.Dock="Top" Height="4" CornerRadius="14,14,0,0" Background="{Binding Color}"/><StackPanel Margin="12"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Synopsis}" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,4,0,8" MaxHeight="52" TextTrimming="CharacterEllipsis"/><DockPanel><Border Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentStrong}"/></Border><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource FgMuted}" FontSize="11"><Run Text="{Binding WordCount, Mode=OneWay}"/><Run Text=" Wörter"/></TextBlock></DockPanel></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        </DataTemplate>
        <!-- Figuren: Liste + Formular -->
        <DataTemplate DataType="{x:Type vm:CharactersViewModel}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ Figur" Command="{Binding NewCharacterCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Löschen" Command="{Binding DeleteCharacterCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/><TextBlock Text="Figuren - Profile, Beziehungen, Entwicklung." Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorCard}" Padding="6"><ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoft}" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentStrong}"/></Border><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource FgMuted}"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource EditorCard}"><StackPanel><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Rolle" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Role, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="Persoenlichkeit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Personality, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"/><TextBlock Text="Hintergrund" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Background, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="Ziele / Motivation" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Goals, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"/></StackPanel></Border></ScrollViewer>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <!-- Welt: Eintraege -->
        <DataTemplate DataType="{x:Type vm:WorldViewModel}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ Eintrag" Command="{Binding NewEntryCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Löschen" Command="{Binding DeleteEntryCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/><TextBlock Text="Welt - Länder, Städte, Fraktionen, Magie." Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorCard}" Padding="6"><ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource FgMuted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                    <Border Grid.Column="2" Style="{StaticResource EditorCard}"><StackPanel><TextBlock Text="Titel" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kategorie" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Category, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <!-- Zeitlinie -->
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ Ereignis" Command="{Binding NewEventCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Zeitlinie - Ereignisse mit freiem Datum." Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding Events}" Padding="0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource EditorCard}" Margin="0,0,0,8" Padding="14"><DockPanel><Border Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="10,4" Margin="0,0,12,0"><TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" Foreground="{StaticResource AccentStrong}" FontSize="12"/></Border><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
        </DataTemplate>
        <!-- Recherche -->
        <DataTemplate DataType="{x:Type vm:ResearchViewModel}">
            <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="+ Notiz" Command="{Binding NewItemCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Recherche - Notizen, Links, Zitate." Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding Items}" Padding="0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource EditorCard}" Margin="0,0,0,8" Padding="14"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
        </DataTemplate>
        <!-- Dashboard: Überblick -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource StatCard}" Padding="20"><StackPanel><TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ProjectTitle}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="{Binding Synopsis}" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="13" Margin="0,8,0,0"/><ProgressBar Value="{Binding Progress}" Height="10" Margin="0,14,0,6" Background="{StaticResource BgPanel2}"/><TextBlock><Run Text="Fortschritt: "/><Run Text="{Binding Progress}"/><Run Text=" % zum Wortziel"/></TextBlock></StackPanel></Border><UniformGrid Columns="3" Margin="0,12,0,0"><Border Style="{StaticResource StatCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Gesamtwoerter" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding TotalWords}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource StatCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Szenen" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Scenes}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="Kapitel" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Chapters}" FontSize="24" FontWeight="Bold"/></StackPanel></Border></UniformGrid></StackPanel></ScrollViewer>
        </DataTemplate>
        <!-- Statistik -->
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <ScrollViewer Margin="20"><StackPanel><TextBlock Text="Schreibstatistik" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource StatCard}" Margin="0,10,0,0"><TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer>
        </DataTemplate>
        <!-- Einstellungen: gruppiert -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer Margin="20"><StackPanel MaxWidth="640" HorizontalAlignment="Left"><TextBlock Text="Einstellungen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="Alles wird lokal gespeichert." Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="KI &amp; DeepAI" Style="{StaticResource SectionTitle}"/><TextBlock Text="KI-Anbieter" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.AiProvider}"/><TextBlock Text="Basis-URL" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.AiBaseUrl}"/><TextBlock Text="KI-Modell (OpenAI-kompatibel, frei)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.AiModel}"/><TextBlock Text="DeepAI-Code-Modell (alle verfügbaren auf diesem PC)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DeepAiModels}" DisplayMemberPath="DisplayText" SelectedValuePath="Id" SelectedValue="{Binding SelectedDeepAiModel, Mode=TwoWay}" MinWidth="320"/><TextBlock Text="28 Modelle: 12× 0 Theos (unlimitiert), 16× Frontier (2–50 Theos/Anfrage). Quelle: deepai.org/chat/ai-code. Auswahl wird in die DeepAI-Analyse übernommen." FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="API-Key" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.AiApiKeyRef}"/><TextBlock Text="Sicherung" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/><CheckBox Content="Autosave" IsChecked="{Binding Settings.Autosave}"/><TextBlock Text="Autosave-Intervall (Sek.)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.AutosaveIntervalSec}"/><TextBlock Text="DeepAI Code" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/><TextBlock Text="DeepAI Code ist nicht in ALICE enthalten – bitte separat installieren (Button unten öffnet die Download-Seite)." FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="DeepAI-Code EXE-Pfad" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Settings.DeepAiExePath}"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Speichern" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="DeepAI Code erkennen" Command="{Binding DetectDeepAiCommand}" Margin="8,0,0,0"/><Button Content="DeepAI Code herunterladen" Command="{Binding OpenDeepAiDownloadCommand}" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="12"/></StackPanel></ScrollViewer>
        </DataTemplate>
        <!-- Storyboard: freies Whiteboard (Canvas + Nodes + Verbindungen) -->
        <DataTemplate DataType="{x:Type vm:StoryboardViewModel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                    <WrapPanel ItemHeight="30">
                        <ComboBox ItemsSource="{Binding Boards}" DisplayMemberPath="Title" SelectedItem="{Binding ActiveBoard, Mode=TwoWay}" MinWidth="140" Margin="0,0,6,0" ToolTip="Board wählen"/>
                        <Button Content="+ Board" Command="{Binding NewBoardCommand}" Margin="0,0,6,0"/>
                        <Button Content="Board löschen" Command="{Binding DeleteActiveBoardCommand}" Margin="0,0,6,0"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                        <Button Content="Hand" Command="{Binding ToggleHandCommand}" Margin="0,0,6,0" ToolTip="Canvas bewegen"/>
                        <Button Content="Verbindung" Command="{Binding ToggleConnectCommand}" Margin="0,0,6,0" ToolTip="Klick auf Quelle, dann Ziel"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                        <Button Content="Zoom +" Command="{Binding ZoomInCommand}" Margin="0,0,6,0"/>
                        <Button Content="Zoom −" Command="{Binding ZoomOutCommand}" Margin="0,0,6,0"/>
                        <Button Content="Alles zeigen" Command="{Binding ZoomFitCommand}" Margin="0,0,6,0"/>
                        <Button Content="Raster" Command="{Binding ToggleGridCommand}" Margin="0,0,6,0"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                        <Button Content="Rückgängig" Command="{Binding UndoBoardCommand}" Margin="0,0,6,0"/>
                        <Button Content="Wiederholen" Command="{Binding RedoBoardCommand}" Margin="0,0,6,0"/>
                        <Button Content="Speichern" Command="{Binding SaveBoardCommand}" Margin="0,0,6,0"/>
                        <Button Content="Gruppe aus Auswahl" Command="{Binding CreateGroupFromSelectionCommand}" Margin="0,0,6,0"/>
                        <Button Content="Hierarchie-Layout" Command="{Binding AutoLayoutCommand}" Margin="0,0,6,0" ToolTip="Automatische Baum-Anordnung (manuell, verschiebbar)"/>
                        <Button Content="Fokus" Command="{Binding FocusSelectedCommand}" Margin="0,0,6,0" ToolTip="Auf ausgewähltes Panel zoomen"/>
                        <Button Content="Kompakt" Command="{Binding CompactViewCommand}" Margin="0,0,6,0"/>
                        <Button Content="Storyboard als PNG" Click="BoardExportPng_Click" Margin="0,0,6,0" ToolTip="Canvas als Bild exportieren"/>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                        <TextBox Text="{Binding FilterType, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0" ToolTip="Filter nach Typ (z. B. Charakter, Idee, Alle Typen)"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,6,0" ToolTip="Nodes durchsuchen"/>
                        <Button Content="Suchen" Command="{Binding RunSearchCommand}" Margin="0,0,6,0"/>
                        <Button Content="Filter zurücksetzen" Command="{Binding ClearFilterCommand}" Margin="0,0,6,0"/>
                    </WrapPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Padding="8,0" Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibilityConverter}}"><ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.GoToNodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,4,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Text="{Binding KiScope, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,6,0" ToolTip="KI-Kontext: Ausgewählte Nodes / Gesamtes Whiteboard / Ausgewählte Gruppe"/>
                            <Button Content="KI-Kontext kopieren" Command="{Binding CopyKiContextCommand}" Margin="0,0,6,0"/>
                            <Button Content="Nodes aus Zwischenablage (KI-Vorschlag)" Command="{Binding NodesFromClipboardCommand}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ZoomLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Right" Width="250" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
                        <TextBlock Text="Node-Eigenschaften" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Titel" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedNode.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>
                        <TextBlock Text="Typ" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding NodeTypeCatalog}" DisplayMemberPath="Label" SelectedValuePath="Type" SelectedValue="{Binding SelectedNode.NodeType, Mode=TwoWay}"/>
