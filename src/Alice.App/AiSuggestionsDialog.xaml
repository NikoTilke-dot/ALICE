<Window x:Class="Alice.App.AiSuggestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Ideen für Unterpanels" Width="600" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Angehakte erstellen" Click="Accept_Click" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
            <Button Content="Abbrechen" Click="Cancel_Click" MinWidth="90" Margin="8,0,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Ziel-Panel (Eltern)" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="ParentText" Text="" FontSize="13" Margin="0,2,0,8"/>
            <TextBlock Text="Wunsch (z. B. „3 Geheimnisse“, „Motivation entwickeln“)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,2,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Ideen generieren" Click="Generate_Click" Style="{StaticResource PrimaryButton}" MinWidth="140"/>
            </StackPanel>
            <TextBlock Text="Vorschläge (nur Angehakte werden als verbundene Unterpanels erstellt)" Style="{StaticResource SectionTitle}"/>
            <StackPanel x:Name="SuggestionsPanel" Margin="0,4,0,0"/>
            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
