<Window x:Class="Alice.App.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt exportieren" Width="480" Height="520" MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Exportieren" Click="Ok_Click" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
            <Button Content="Abbrechen" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="90"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Format" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="FormatBox" IsEditable="False" MinWidth="260" Margin="0,4,0,8">
                <ComboBoxItem Content="PDF" Tag="Pdf"/><ComboBoxItem Content="DOCX (Word)" Tag="Docx"/>
                <ComboBoxItem Content="RTF" Tag="Rtf"/><ComboBoxItem Content="ODT (LibreOffice)" Tag="Odt"/>
                <ComboBoxItem Content="TXT" Tag="Txt"/><ComboBoxItem Content="Markdown (.md)" Tag="Markdown"/>
                <ComboBoxItem Content="HTML" Tag="Html"/><ComboBoxItem Content="EPUB (E-Book)" Tag="Epub"/>
                <ComboBoxItem Content="ZIP (Projekt + Assets)" Tag="Zip"/>
            </ComboBox>
            <TextBlock Text="Umfang" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="ScopeBox" IsEditable="False" MinWidth="260" Margin="0,4,0,8">
                <ComboBoxItem Content="Gesamtes Buch (Manuskript + Storyboard)"/>
                <ComboBoxItem Content="Nur Manuskript"/>
                <ComboBoxItem Content="Nur Storyboard"/>
            </ComboBox>
            <TextBlock Text="PDF-Optionen" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="TocBox" Content="Inhaltsverzeichnis (Kapitel)"/>
            <CheckBox x:Name="TitlePageBox" Content="Titelblatt"/>
            <CheckBox x:Name="PageNumbersBox" Content="Seitenzahlen"/>
            <CheckBox x:Name="ChapterPageBox" Content="Kapitel auf neuer Seite"/>
            <TextBlock Text="Seitenformat" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PageFormatBox" IsEditable="False" MinWidth="140"><ComboBoxItem Content="A4" Tag="A4"/><ComboBoxItem Content="Letter" Tag="Letter"/></ComboBox>
            <TextBlock Text="Schriftgröße (PDF, pt)" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="FontSizeBox" IsEditable="False" MinWidth="140"><ComboBoxItem Content="10" Tag="10"/><ComboBoxItem Content="11" Tag="11"/><ComboBoxItem Content="12" Tag="12"/></ComboBox>
            <TextBlock Text="Hinweis: PDF/DOCX/EPUB enthalten Kapitelstruktur, TXT/MD/HTML den Fließtext inkl. Storyboard-Anhang. Datei-Ertrag wird erst nach erfolgreichem Schreiben gemeldet." FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
