<Window x:Class="Alice.App.InlineAiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI im Text schreiben" Width="640" Height="620" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Einfügen" Click="Insert_Click" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
            <Button Content="Ersetzen" Click="Replace_Click" MinWidth="90" Margin="8,0,0,0"/>
            <Button Content="Verwerfen" Click="Cancel_Click" MinWidth="90" Margin="8,0,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Anweisung an die KI (wird NICHT Teil des Manuskripts)" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,4,0,8"/>
            <TextBlock Text="Modell" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ModelBox" IsEditable="False" MinWidth="320" Margin="0,2,0,8"/>
            <TextBlock Text="Kontext" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <CheckBox x:Name="CtxSelection" Content="Auswahl" IsChecked="True" Margin="0,0,12,0"/>
                <CheckBox x:Name="CtxScene" Content="Umgebender Text" IsChecked="True" Margin="0,0,12,0"/>
                <CheckBox x:Name="CtxChars" Content="Figuren" IsChecked="True" Margin="0,0,12,0"/>
                <CheckBox x:Name="CtxWorld" Content="Welt" Margin="0,0,12,0"/>
                <CheckBox x:Name="CtxBoard" Content="Storyboard (alle Panels)"/>
            </StackPanel>
            <TextBlock Text="Kontext-Vorschau (wird so an die KI gesendet)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ContextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" Margin="0,2,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Generieren" Click="Generate_Click" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
                <Button Content="Neu generieren" Click="Generate_Click" MinWidth="130" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Ergebnis (bearbeitbar, Übernahme nur per Button)" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" Margin="0,4,0,0"/>
            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
